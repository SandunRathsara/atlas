# Copy this file to /etc/atlas/github.env and replace the non-secret values.
# Keep the installed copy owner-readable (0600). The App key itself is a
# separate 0600 file outside releases, clones, and this repository.

ATLAS_GITHUB_ORGANIZATION=your-organization
ATLAS_GITHUB_INSTALLATION_ID=123456
ATLAS_GITHUB_APP_ID=123456
ATLAS_GITHUB_APP_PRIVATE_KEY_PATH=/etc/atlas/github-app.pem

# Optional browse-only compatibility token. Do not use this as preparation
# credentials; the Atlas supplier mints one Repository-scoped App token.
# ATLAS_GITHUB_INSTALLATION_TOKEN=
