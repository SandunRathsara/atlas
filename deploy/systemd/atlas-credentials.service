[Unit]
Description=Atlas Repository-scoped credential supplier
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/atlas/services/atlas-credentials /opt/atlas/tools /var/lib/atlas /etc/atlas /home/omega
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=omega
Group=omega
WorkingDirectory=/opt/atlas/services/atlas-credentials
Environment=HOME=/home/omega
Environment=ATLAS_GITHUB_ENV_PATH=/etc/atlas/github.env
Environment=ATLAS_CREDENTIAL_REGISTRY_PATH=/var/lib/atlas/session-scopes.json
Environment=ATLAS_SUPPLIER_SOCKET=/run/atlas/supplier.sock
Environment=ATLAS_SUPPLIER_KEY_PATH=/etc/atlas/supplier.key
ExecStartPre=/usr/bin/test -x /opt/atlas/tools/bun/1.3.14/bin/bun
ExecStartPre=/usr/bin/test -f /opt/atlas/services/atlas-credentials/credential-server.ts
ExecStartPre=/usr/bin/test -f /opt/atlas/services/atlas-credentials/credentials.ts
ExecStart=/opt/atlas/tools/bun/1.3.14/bin/bun /opt/atlas/services/atlas-credentials/credential-server.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
SyslogIdentifier=atlas-credentials
LogNamespace=atlas
UMask=0077
RuntimeDirectory=atlas
RuntimeDirectoryMode=0700
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
