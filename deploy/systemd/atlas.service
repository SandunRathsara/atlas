[Unit]
Description=Atlas private UI and webhook observer
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/atlas/current /opt/atlas/tools /var/lib/atlas /etc/atlas /home/omega
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=omega
Group=omega
WorkingDirectory=/opt/atlas/current
Environment=HOME=/home/omega
Environment=PATH=/opt/atlas/current/deploy/bin:/opt/atlas/tools/bun/1.3.14/bin:/opt/atlas/tools/gh/2.100.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=ATLAS_RELEASE_ROOT=/opt/atlas/current
Environment=ATLAS_BUN_BINARY=/opt/atlas/tools/bun/1.3.14/bin/bun
Environment=ATLAS_REAL_GH=/opt/atlas/tools/gh/2.100.0/bin/gh
EnvironmentFile=/etc/atlas/atlas.env
ExecStartPre=/usr/bin/test -d /opt/atlas/current
ExecStartPre=/usr/bin/test -x /opt/atlas/tools/bun/1.3.14/bin/bun
ExecStartPre=/usr/bin/test -f /etc/atlas/atlas.env
ExecStartPre=/usr/bin/test -d /var/lib/atlas
ExecStart=/opt/atlas/tools/bun/1.3.14/bin/bun /opt/atlas/current/src/server.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=atlas
RuntimeDirectoryMode=0700
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
