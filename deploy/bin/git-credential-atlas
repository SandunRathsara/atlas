#!/bin/sh
set -eu

release_root=${ATLAS_RELEASE_ROOT:-/opt/atlas/current}
bun_binary=${ATLAS_BUN_BINARY:-/opt/atlas/tools/bun/1.3.14/bin/bun}

case "$release_root:$bun_binary" in
  /*:/*) ;;
  *) echo "Atlas Git helper requires absolute paths" >&2; exit 1 ;;
esac
test -x "$bun_binary" || { echo "Atlas Bun runtime is unavailable" >&2; exit 1; }
test -f "$release_root/scripts/atlas-git-credential.ts" || { echo "Atlas Git helper is unavailable" >&2; exit 1; }

export ATLAS_RELEASE_ROOT="$release_root"
export ATLAS_BUN_BINARY="$bun_binary"
exec "$bun_binary" "$release_root/scripts/atlas-git-credential.ts" "$@"
