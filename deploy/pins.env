# Non-secret pins for the operator recovery tools in deploy/ (snapshot capture,
# restore rehearsal, SQLite WAL probe). Atlas itself is one compiled binary and
# needs no Bun; its host git/gh minimums live in src/host-tools.ts. OpenCode is
# selected independently by the operator through its current symlink.
ATLAS_BUN_VERSION=1.3.14
ATLAS_GIT_VERSION=2.55.0
ATLAS_GH_VERSION=2.100.0
# Packaged client dependency only; never an OpenCode server selection or gate.
ATLAS_OPENCODE_CLIENT_VERSION=2.3.2

ATLAS_BUN_BINARY=/opt/atlas/tools/bun/1.3.14/bin/bun
ATLAS_OPENCODE_BINARY=/opt/atlas/tools/opencode/current/bin/opencode
ATLAS_GIT_BINARY=/opt/atlas/tools/git/2.55.0/bin/git
ATLAS_GIT_WRAPPER=/opt/atlas/current/bin/git
ATLAS_REAL_GH=/opt/atlas/tools/gh/2.100.0/bin/gh
