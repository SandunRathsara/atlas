# Non-secret deployment pins. These paths are deliberately versioned and do
# not use interactive mise shims. Obtain binaries independently and record
# their checksums in the operator's private change record before cutover.
ATLAS_BUN_VERSION=1.3.14
ATLAS_OPENCODE_VERSION=0.0.0-beta-19135
ATLAS_OPENCODE_CLIENT_VERSION=0.0.0-beta-19135
ATLAS_GIT_VERSION=2.55.0
ATLAS_GH_VERSION=2.100.0

ATLAS_BUN_BINARY=/opt/atlas/tools/bun/1.3.14/bin/bun
ATLAS_OPENCODE_BINARY=/opt/atlas/tools/opencode/0.0.0-beta-19135/bin/opencode2
ATLAS_GIT_BINARY=/usr/bin/git
ATLAS_REAL_GH=/opt/atlas/tools/gh/2.100.0/bin/gh
