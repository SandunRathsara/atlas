# Non-secret deployment pins. Bun, Git, and gh paths are deliberately versioned
# and do not use interactive mise shims. OpenCode is selected independently by
# the operator through its current symlink.
ATLAS_BUN_VERSION=1.3.14
ATLAS_GIT_VERSION=2.55.0
ATLAS_GH_VERSION=2.100.0
# Packaged client dependency only; never an OpenCode server selection or gate.
ATLAS_OPENCODE_CLIENT_VERSION=0.0.0-beta-19135

ATLAS_BUN_BINARY=/opt/atlas/tools/bun/1.3.14/bin/bun
ATLAS_OPENCODE_BINARY=/opt/atlas/tools/opencode/current/bin/opencode2
ATLAS_GIT_BINARY=/opt/atlas/tools/git/2.55.0/bin/git
ATLAS_GIT_WRAPPER=/opt/atlas/current/deploy/bin/git
ATLAS_REAL_GH=/opt/atlas/tools/gh/2.100.0/bin/gh
