# Copy this file to /etc/atlas/atlas.env and replace the two required values.
# Keep the installed copy owner-readable (0600), outside source releases.
# This example intentionally contains no usable credentials.

ATLAS_SHARED_TOKEN=REPLACE_WITH_PRIVATE_SHARED_TOKEN
ATLAS_GITHUB_WEBHOOK_SECRET=REPLACE_WITH_GITHUB_WEBHOOK_SECRET

# The origin is the private Tailscale HTTPS URL, not the public Funnel URL.
ATLAS_ORIGIN=https://atlas.example.ts.net
ATLAS_PORT=3000
ATLAS_WEBHOOK_PORT=3001

ATLAS_GITHUB_ENV_PATH=/etc/atlas/github.env
ATLAS_DATABASE_PATH=/var/lib/atlas/atlas.sqlite
ATLAS_SESSION_ROOT=/var/lib/atlas/sessions
ATLAS_GLOBAL_CAPACITY=1
ATLAS_STORAGE_WARNING_BYTES=21474836480
ATLAS_MIN_FREE_BYTES=10737418240
ATLAS_BTRFS_METADATA_WARNING_PERCENT=80
ATLAS_BTRFS_METADATA_PAUSE_PERCENT=90
ATLAS_BTRFS_METADATA_REQUIRED=1

# Durable Session-to-Repository registry; runtime socket; restricted key.
ATLAS_CREDENTIAL_REGISTRY_PATH=/var/lib/atlas/session-scopes.json
ATLAS_SUPPLIER_SOCKET=/run/atlas/supplier.sock
ATLAS_SUPPLIER_KEY_PATH=/etc/atlas/supplier.key
ATLAS_GIT_BINARY=/opt/atlas/current/deploy/bin/git
ATLAS_RECOVERY_CONFIG_ROOT=/var/lib/atlas/recovery-config
OPENCODE_SERVICE_FILE=/var/lib/atlas/opencode-state/opencode/service.json

# Optional for browse compatibility only. Preparation uses the App supplier.
# ATLAS_GITHUB_INSTALLATION_TOKEN=
