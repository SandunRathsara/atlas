{
  "name": "atlas",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/app.css --minify",
    "check": "tsc --noEmit",
    "verify:issue31": "bun scripts/verify-issue31.ts",
    "verify:issue25": "bun scripts/verify-issue25.ts",
    "dev": "bun run build:css && bun --watch src/server.ts",
    "start": "bun run build:css && bun src/server.ts"
  },
  "dependencies": {
    "hono": "4.13.7",
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.1",
    "daisyui": "5.7.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
