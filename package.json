{
  "name": "atlas",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/app.css --minify",
    "check": "tsc --noEmit",
    "verify:issue31": "bun scripts/verify-issue31.ts",
    "verify:issue25": "bun scripts/verify-issue25.ts",
    "verify:migrations": "bun scripts/verify-migrations.ts",
    "verify:issue27": "bun scripts/verify-issue27.ts",
    "verify:issue27-fixes": "bun scripts/verify-issue27-fixes.ts",
    "verify:issue32": "bun scripts/verify-issue32-backoff.ts",
    "verify:issue29": "bun scripts/verify-issue29.ts",
    "verify:issue52": "bun scripts/verify-issue52.ts",
    "verify:issue55": "bun scripts/verify-issue55.ts",
    "verify:inbox": "bun scripts/verify-inbox.ts",
    "verify:landing": "bun scripts/verify-landing.ts",
    "verify:inbox-shell": "bun scripts/verify-inbox-shell.ts",
    "verify:inbox-page": "bun scripts/verify-inbox-page.ts",
    "credentials": "bun src/credential-server.ts",
    "dev": "bun run build:css && bun --watch src/server.ts",
    "start": "bun run build:css && bun src/server.ts"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-beta-19135",
    "hono": "4.13.7",
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.1",
    "daisyui": "5.7.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
